{
  "name": "panda-launchpad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify-tx": "tsx scripts/verify-tx.ts",
    "check-sharing": "tsx scripts/check-sharing.ts",
    "create-lookup-table": "tsx scripts/create-launch-lookup-table.ts",
    "check-lookup-table": "tsx scripts/check-launch-lookup-table.ts",
    "vercel-build": "tsx scripts/vercel-build.ts",
    "verify-services": "tsx --env-file-if-exists=.env.local scripts/verify-services.ts",
    "verify-audit-chain": "tsx --env-file-if-exists=.env.local scripts/verify-audit-chain.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "db:backfill": "tsx --env-file-if-exists=.env.local scripts/db-backfill.ts",
    "db:compare": "tsx --env-file-if-exists=.env.local scripts/db-compare.ts",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/umi": "^1.6.0",
