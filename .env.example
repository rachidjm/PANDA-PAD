# Mainnet Solana RPC used for reading pool state and sending real trades.
# The public clusterApiUrl fallback is heavily rate-limited — get a provider
# (Helius, QuickNode, Triton, Alchemy...) and paste its URL here for anything
# beyond local testing. Nothing else needs to change — the app picks this up
# automatically once it's set (in Vercel: Project Settings → Environment
# Variables, then redeploy).
NEXT_PUBLIC_SOLANA_RPC_URL=

# Where PANDA's trades take its cut of every buy/sell — see src/lib/pump/client.ts.
# Already set to a real address; only change this if the treasury wallet moves.
NEXT_PUBLIC_PANDA_TREASURY=GJvaNLciu58gCyJap2tzGam76SS1w2Bg9bHbfKyzxb8m

# The $PANDA token's mint address, once it exists. Leave empty until then —
# the Rewards page shows an honest "not launched yet" state instead of any
# balance when this is unset.
NEXT_PUBLIC_PANDA_TOKEN_MINT=

# Where a coin's "Holders" creator-fee share lands when a creator sets up Fee
# Distribution in Create — a public key only, same convention as
# NEXT_PUBLIC_PANDA_TREASURY above. Leave empty until you've generated this
# wallet; Fee Distribution and the Rewards dashboard both show an honest
# "not configured" state instead of a fake address when it's unset.
# IMPORTANT: this is a PUBLIC key. The matching private key (below) must be
# generated and stored as a server-only secret by you directly — never paste
# it into chat, a NEXT_PUBLIC_* variable, or this file.
NEXT_PUBLIC_PANDA_REWARDS_POOL=

# The Rewards Pool wallet's REAL PRIVATE KEY — server-only, no NEXT_PUBLIC_
# prefix, never sent to the browser. Used by src/app/api/cron/collect-fees
# (to trigger real on-chain fee collection) and src/app/api/rewards/claim
# (to sign real payouts to holders). Generate a dedicated wallet just for
# this (Phantom/Solflare "export private key", or `solana-keygen new`) —
# never reuse your personal wallet or NEXT_PUBLIC_PANDA_TREASURY's key.
# Format: either a base58 string (Phantom/Solflare's "Export Private Key")
# or a JSON array like solana-keygen produces, e.g. [12,34,...] — both work.
# Set this directly in your hosting provider's environment variables — never
# paste the real value into chat, a commit, or anywhere client-readable.
PANDA_REWARDS_POOL_SECRET_KEY=

# Shared secret that guards /api/cron/collect-fees and lets you manually
# trigger it for testing. If you set this in Vercel's Environment Variables,
# Vercel automatically sends it as `Authorization: Bearer <value>` on every
# real cron-triggered request — generate any long random string.
CRON_SECRET=

# Jupiter Trigger API key (portal.jup.ag → create/join a team → generate a
# key — Free tier is enough to start) — powers real Stop Loss / Take Profit
# orders on a coin's page (src/lib/jupiter/trigger.ts). Server-only, no
# NEXT_PUBLIC_ prefix: it's sent as the `x-api-key` header on PANDA's own
# server-to-Jupiter calls and never reaches the browser. Note: Jupiter's
# Trigger API holds order funds in a Privy-managed custodial vault per
# wallet, not in the user's own wallet — this is disclosed in the app's UI
# wherever an order is created.
JUPITER_API_KEY=

# Payout safety limits for src/app/api/rewards/claim (all optional — defaults shown).
# A single claim never pays more than REWARDS_MAX_CLAIM_SOL (bigger balances are
# paid over several claims), and the pool never pays out more than
# REWARDS_DAILY_CAP_SOL per UTC day in total.
REWARDS_MAX_CLAIM_SOL=2
REWARDS_DAILY_CAP_SOL=20

# Optional: a Discord or Slack incoming-webhook URL. When set, PANDA posts an
# alert there on payout failures, unknown claim outcomes, a hit daily cap, a
# low or under-funded Rewards Pool, and cron failures. Server-only. Alerts are
# always written to the Vercel logs either way.
ALERT_WEBHOOK_URL=

# Solana RPC used by PANDA's SERVER (server-only, never sent to the browser).
# Needed for Portfolio, Rewards and history: the free public RPC rejects
# wallet-scanning queries with 403. Get a free key (Helius, QuickNode,
# Alchemy...) and paste the full URL here in Vercel's Environment Variables.
# Browser reads go through PANDA's own /api/rpc proxy, so the key stays hidden.
SOLANA_RPC_URL=

# --- Feature flags (SERVER_ONLY). Off unless exactly "true". None are wired to a feature yet. ---
# FEATURE_NFT_THEMES=
# FEATURE_NFT_MARKET=
# FEATURE_NFT_SECONDARY=
# FEATURE_PANDA_POINTS=
# FEATURE_PANDA_AIRDROPS=
# FEATURE_CREATOR_REWARDS=
# FEATURE_MERKLE_CLAIMS=

# --- Wallet sign-in (SERVER_ONLY) ---
# Required for claims: at least 32 random chars. Without it, sign-in and claims fail closed.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SESSION_SECRET=

# --- Admin (SERVER_ONLY) ---
# Comma-separated wallet addresses allowed to use /admin (pause switches, audit log). Empty = nobody.
# Admin actions also need a wallet sign-in from the last 30 minutes.
ADMIN_WALLETS=

# --- Airdrops (SERVER_ONLY unless noted) ---
# A DEDICATED wallet that holds the PANDA tokens to airdrop — not the Rewards Pool, not the Treasury.
# Base58 or JSON byte array. Never commit it; ideally fund it only with what an epoch needs.
PANDA_AIRDROP_POOL_SECRET_KEY=
# (NEXT_PUBLIC_PANDA_TOKEN_MINT above is also required: it is the token being airdropped.)
# Flags: FEATURE_PANDA_AIRDROPS enables publishing/reading; FEATURE_MERKLE_CLAIMS separately enables the
# money-moving claim endpoint. Both are off unless exactly "true".
