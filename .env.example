# PANDA — environment variables, grouped by subsystem.
#
# Nothing here is a secret by itself: this file only lists NAMES. Real values go in Vercel
# (Project → Settings → Environment Variables), never in git, chat, or anything client-readable.
# Variables prefixed NEXT_PUBLIC_ are shipped to every browser — public keys only, never a secret.
# GET /api/health/trading reports each variable as present / absent / invalid (never its value) and
# says what is missing. docs/DEPLOY_CHECKLIST.md is the order to do all of this in.
#
# "Core" = required for the launch scope (Discover, buy/sell, Create Standard, Portfolio).
# In production, money-moving flows stay blocked without NETWORK, SOLANA_RPC_URL and a valid
# NEXT_PUBLIC_PANDA_TREASURY (see src/lib/config/network.ts).

# ══ CORE ═══════════════════════════════════════════════════════════════════════════════════════════

# Which Solana network this deployment is for: "mainnet" or "devnet".
# Before any transaction is built, the RPC's genesis hash must match this, else trading is blocked.
# Use "devnet" (with a devnet RPC) on Preview deployments so a test can never touch real money.
NETWORK=

# Solana RPC used by PANDA's SERVER (server-only; the browser goes through PANDA's /api/rpc proxy, so the key stays hidden).
# Use a dedicated provider (Helius, QuickNode, Alchemy...). Solana's public endpoint drops trades and
# rejects the wallet-scanning queries Portfolio needs (403); /api/health/trading warns if it is what's in use.
SOLANA_RPC_URL=

# PANDA's own wallet that receives the 0.5% trading fee on every buy and sell (public address only).
# If unset, a built-in default address would receive the fees, so production refuses to trade without it.
# It needs at least ~0.002 SOL in it: a system account can't be left under the rent minimum by a small fee.
NEXT_PUBLIC_PANDA_TREASURY=

# Mainnet only: declare "true" once NEXT_PUBLIC_PANDA_TREASURY is a multisig vault (Squads). Until then, on mainnet,
# coin creation is BLOCKED (buying and selling still work): the treasury address is written into every coin's on-chain
# fee config and can't be changed afterwards. This is YOUR attestation — the code can't verify from the chain that an
# address is a multisig. Leave empty/false until it is.
TREASURY_IS_MULTISIG=

# PANDA's Address Lookup Table for launches (public address, not a secret). With it, creating a coin and setting its fee
# split (PANDA's locked 5%) is ONE atomic transaction / one signature. Without it a launch takes two transactions and the
# coin stays out of PANDA's lists until the second is confirmed. Create it once with `npm run create-lookup-table`
# (dry run by default; you run it with your own wallet), verify with `npm run check-lookup-table`.
PANDA_LOOKUP_TABLE=

# Signs the wallet sign-in cookie. At least 32 random characters; without it nobody can sign in or claim rewards.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SESSION_SECRET=

# Comma-separated wallet addresses allowed into /admin (pause switches, audit log). Empty = nobody is admin.
# Admin actions also need a wallet sign-in from the last 30 minutes.
ADMIN_WALLETS=

# Guards /api/cron/collect-fees. Vercel sends it as `Authorization: Bearer <value>` on the daily cron.
# Any long random string (same generator as above); without it the cron refuses to run.
CRON_SECRET=

# ══ STORAGE (core) ═════════════════════════════════════════════════════════════════════════════════

# Vercel Blob read/write token: hosts each coin's image + metadata (Create) and every JSON ledger PANDA keeps.
# Connecting a Blob store to the project sets this; the alternative names below are accepted too because
# Vercel's "connect a store" flow doesn't always use the plain one.
BLOB_READ_WRITE_TOKEN=
# BLOB_READ_WRITE_TOKEN_READ_WRITE_TOKEN=
# PANDA_PAD_BLOB_READ_WRITE_TOKEN=

# ══ POSTGRES (phase 6, point 1 — optional until you migrate; see docs/PHASE6_PLAN.md) ══════════════════════════════
# Where each domain lives during the Blob → Postgres migration: blob (default = today) | dual (Blob is the source of truth, every
# write is mirrored into Postgres) | postgres (Postgres only). Domains: rewards, trades, activity, pause.
# Example: PANDA_STORAGE_MODES=pause=dual,trades=dual
PANDA_STORAGE_MODES=
# Neon connection strings (from the Vercel Marketplace integration). DATABASE_URL is the pooled one the app uses; the UNPOOLED one is
# only for `npm run db:migrate`. Secrets: set them in Vercel / your local .env.local, never in git or chat.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ══ OPTIONAL: read RPC for the browser bundle (legacy) ═════════════════════════════════════════════
# Leave empty. It would be shipped to every browser, so it must never hold a provider key.
# (SOLANA_RPC_URL is used first on the server.)
NEXT_PUBLIC_SOLANA_RPC_URL=

# ══ HOLDER REWARDS (OFF at launch) ═════════════════════════════════════════════════════════════════
# FEATURE_HOLDER_REWARDS is off by default: Create doesn't offer the "Holders" band (the split is PANDA 5% + Creator +
# optional partner) and the server refuses any split that includes it. Re-enable only after phase 6 (docs/PHASE6_PLAN.md).
# FEATURE_HOLDER_REWARDS=
# Where a coin's "Holders" creator-fee share lands. Public address. Leave empty and Create shows holders
# routing as "not configured". NOTE: the matching key below is held by PANDA's servers, so fees sit in
# a PANDA-controlled wallet until holders claim them — the legal texts say so.
NEXT_PUBLIC_PANDA_REWARDS_POOL=
# The Rewards Pool wallet's PRIVATE key — server-only. Required if the pool address above is set.
# Base58 (Phantom/Solflare "export private key") or a JSON byte array. A DEDICATED wallet: never your
# personal one, never the treasury. Set it in Vercel directly; never paste it into chat or a file.
PANDA_REWARDS_POOL_SECRET_KEY=
# Payout safety limits (optional; defaults shown): one claim never pays more than the first, and the pool
# never pays out more than the second per UTC day in total.
REWARDS_MAX_CLAIM_SOL=2
REWARDS_DAILY_CAP_SOL=20

# ══ ALERTS (optional) ══════════════════════════════════════════════════════════════════════════════
# A Discord or Slack incoming-webhook URL. Alerts (failed payouts, unknown claim outcomes, hit daily cap,
# low or under-funded pool, cron failures) always go to the Vercel logs; this also posts them there.
ALERT_WEBHOOK_URL=

# ══ FEATURE: STRATEGIES (off by default) ═══════════════════════════════════════════════════════════
# Draw Your Trade + Stop Loss / Take Profit. CUSTODIAL: funds sit in Jupiter's Trigger vault (held by Privy)
# while an order is open. Never signed on mainnet yet. When off: no UI, every related route answers 403,
# and the legal texts don't mention the vault. When on, they add the Privy custody and risk sections.
FEATURE_STRATEGIES=
# Jupiter Trigger API key (portal.jup.ag). Server-only; required when FEATURE_STRATEGIES=true.
JUPITER_API_KEY=

# ══ FEATURE: OTC REWARDS (off by default) ══════════════════════════════════════════════════════════
# The "Rewards" mode of /create (OTC / Meteora launcher). Needs no API key: OTC's docs say there is none.
# Never signed on mainnet yet. When off: no toggle, and /api/otc/* answers 403.
FEATURE_OTC_REWARDS=

# ══ $PANDA TOKEN AND AIRDROPS (off by default) ═════════════════════════════════════════════════════
# The $PANDA token's mint (public). Empty = the app shows an honest "not launched yet" instead of any balance.
NEXT_PUBLIC_PANDA_TOKEN_MINT=
# FEATURE_PANDA_AIRDROPS publishes/reads airdrops; FEATURE_MERKLE_CLAIMS separately enables the endpoint
# that moves tokens. Both need FEATURE_PANDA_POINTS. Server-authorised, not trustless.
# FEATURE_PANDA_AIRDROPS=
# FEATURE_MERKLE_CLAIMS=
# A DEDICATED wallet holding the tokens to airdrop (not the Rewards Pool, not the treasury). Base58 or JSON array.
PANDA_AIRDROP_POOL_SECRET_KEY=

# ══ POINTS, NFTs (all off by default; outside the launch scope) ════════════════════════════════════
# Each flag is on only when its value is exactly "true".
# FEATURE_PANDA_POINTS=        points, epochs and the anti-abuse engine
# FEATURE_NFT_THEMES=          NFT themes and creation
# FEATURE_NFT_BRANCHES=        branches of themes (also needs FEATURE_NFT_THEMES)
# FEATURE_NFT_MARKET=          NFT marketplace list/buy/cancel
# FEATURE_NFT_SECONDARY=       resales on the NFT marketplace
# FEATURE_CREATOR_REWARDS=     reserved; no feature is wired to it yet
# A DEDICATED key that holds NO funds; it only signs NFT transfers for listings sellers approved.
# Required when FEATURE_NFT_MARKET=true; unset, the market answers 503 (fail closed).
PANDA_MARKET_AUTHORITY_SECRET_KEY=
# Optional: your site's public URL, used for links in NFT metadata.
NEXT_PUBLIC_SITE_URL=
