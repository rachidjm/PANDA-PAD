# Mainnet Solana RPC used for reading pool state and sending real trades.
# The public clusterApiUrl fallback is heavily rate-limited — get a provider
# (Helius, QuickNode, Triton, Alchemy...) and paste its URL here for anything
# beyond local testing. Nothing else needs to change — the app picks this up
# automatically once it's set (in Vercel: Project Settings → Environment
# Variables, then redeploy).
NEXT_PUBLIC_SOLANA_RPC_URL=

# Where PANDA's trades take its cut of every buy/sell — see src/lib/pump/client.ts.
# Already set to a real address; only change this if the treasury wallet moves.
NEXT_PUBLIC_PANDA_TREASURY=GJvaNLciu58gCyJap2tzGam76SS1w2Bg9bHbfKyzxb8m

# The $PANDA token's mint address, once it exists. Leave empty until then —
# the Rewards page shows an honest "not launched yet" state instead of any
# balance when this is unset.
NEXT_PUBLIC_PANDA_TOKEN_MINT=
